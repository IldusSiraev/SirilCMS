# admin ({{name}}-admin) и web ({{name}}-web) читают эти переменные из окружения (dotenv/compose/hosting).

# --- общие секреты ---
PAYLOAD_SECRET=change-me-32-chars-min-0123456789
PURGE_TOKEN=change-me-purge-token

# --- admin ---
PAYLOAD_DB_URI=postgresql://payload:dev@localhost:5433/payload
# Origin админки: ДОЛЖЕН совпадать с адресом, по которому её открывают (иначе save/publish падают на CSRF)
PAYLOAD_URL=http://localhost:3001
# Куда admin шлёт purge кэша при публикации
NUXT_URL=http://localhost:3000
# Первый owner (в проде самрегистрация отключена: DISABLE_FIRST_USER_SIGNUP=true)
# INITIAL_OWNER_EMAIL=
# INITIAL_OWNER_PASSWORD=
# DISABLE_FIRST_USER_SIGNUP=true

# --- web ---
NUXT_PUBLIC_SITE_DOMAIN=localhost:3000
# Origin админки для картинок
NUXT_PUBLIC_MEDIA_BASE=http://localhost:3001
