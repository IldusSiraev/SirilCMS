PAYLOAD_SECRET=change-me-32-chars-min
PAYLOAD_DB_URI=postgresql://payload:dev@localhost:5432/payload
PAYLOAD_URL=http://localhost:3001
NUXT_PUBLIC_SITE_DOMAIN=localhost:3000
PURGE_TOKEN=dev-purge-token
TELEGRAM_BOT_TOKEN=

# --- Production (docker, infra/docker-compose.prod.yml) ---
IMAGE_TAG=latest   # or a released version tag, e.g. v1.2.3 — ghcr.io/ildussiraev/sirilcms-{admin,web,admin-migrate}
SITE_DOMAIN=client.example.com
# SITE_DOMAINS=client.example.com another-client.example.com   # optional, multi-site (one owner): space-separated list of public domains for Caddy; default = SITE_DOMAIN alone. Admin stays on a single admin.SITE_DOMAIN regardless.
POSTGRES_USER=payload
POSTGRES_PASSWORD=
POSTGRES_DB=payload
POSTGRES_DB_URI=postgresql://payload:***@postgres:5432/payload
# NUXT_PUBLIC_MEDIA_BASE=https://admin.client.example.com   # optional override; default derives from SITE_DOMAIN
